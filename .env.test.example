NODE_ENV=test
PORT=4000

# The app connects as support_app: a non-owner role with no BYPASSRLS.
DATABASE_URL=postgres://support_app:support_app@localhost:5432/support_test
# The admin dashboard connects as crm_admin: BYPASSRLS, gated in application code
# behind agent.is_admin (see requireAdminAccess.ts). Never used outside /admin/*.
ADMIN_DATABASE_URL=postgres://crm_admin:crm_admin@localhost:5432/support_test
# Migrations, RLS setup and test truncation connect as the owner.
MIGRATION_DATABASE_URL=postgres://support_owner:support_owner@localhost:5432/support_test

REDIS_URL=redis://localhost:6379

# Fake but well-formed — no live Weaviate calls happen in tests, they're always mocked.
WEAVIATE_URL=https://weaviate-test.example.com
WEAVIATE_API_KEY=weaviate-test-api-key
OPENAI_MODEL=gpt-5.4-mini
LANGFUSE_SECRET_KEY="sk-lxxxxxxx"
LANGFUSE_PUBLIC_KEY="pk-lxxxxxxx"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# 32+ chars. Generate with: openssl rand -base64 48
PLAYER_JWT_SECRET=change-me-change-me-change-me-change-me
PLAYER_TOKEN_TTL_SECONDS=900
# Stands in for the Google-OAuth agent session this slice defers. 32+ chars.
AGENT_SESSION_JWT_SECRET=change-me-change-me-change-me-change-me
SESSION_TIMEOUT_MINUTES=30

# Comma-separated origins allowed to call /surface/* from a browser.
SURFACE_ORIGINS=http://localhost:5173
