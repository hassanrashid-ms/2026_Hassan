{
  "name": "support-crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @support/api --filter @support/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:setup": "pnpm --filter @support/api db:setup",
    "db:generate": "pnpm --filter @support/api db:generate",
    "db:baseline": "pnpm --filter @support/api db:baseline",
    "db:seed": "pnpm --filter @support/api db:seed",
    "repomix": "repomix --compress",
    "repomix:watch": "repomix --watch --compress",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "http-proxy": "^1.18.1",
    "prettier": "^3.9.6",
    "repomix": "^1.18.0",
    "typescript-eslint": "^8.66.0"
  }
}
