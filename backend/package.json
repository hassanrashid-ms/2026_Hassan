  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@langfuse/openai": "^5.10.0",
    "@langfuse/otel": "^5.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@socket.io/redis-adapter": "^8",
    "@support/types": "workspace:*",
    "bullmq": "^5",
    "cors": "^2",
    "dotenv": "^16",
    "drizzle-orm": "latest",
    "express": "^5",
    "ioredis": "^5",
    "jose": "^6",
    "openai": "^7.4.0",
    "pg": "^8",
    "socket.io": "^4",
    "swagger-ui-express": "^5.0.1",
    "weaviate-client": "^3",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/supertest": "^6",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "latest",
    "socket.io-client": "^4",
    "supertest": "^7",
    "typescript": "^5",
    "vitest": "latest"
  }
