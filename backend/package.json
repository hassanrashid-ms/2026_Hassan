{
  "name": "@support/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "node --experimental-strip-types src/shared/db/setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:baseline": "node --experimental-strip-types src/shared/db/baseline.ts",
    "db:seed": "node --experimental-strip-types src/shared/db/seed.ts",
    "db:backfill-bot-config": "node --experimental-strip-types src/shared/db/migrations/backfillBotConfig.ts",
    "db:studio": "drizzle-kit studio",
    "weaviate:setup": "node --experimental-strip-types scripts/setup-weaviate-collection.ts"
